 "tafsirs": {
  "16": {
   "18:60": {
    "verses": {
     "18:60": {
      "id": 2200
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">واذكر حين قال موسى لخادمه يوشع بن نون:</span> لا أزال أتابع السير حتى أصل إلى ملتقى البحرين، أو أسير زمنًا طويلا حتى أصل إلى العبد الصالح؛ لأتعلم منه ما ليس عندي من العلم."
   },
   "18:61": {
    "verses": {
     "18:61": {
      "id": 2201
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "وجَدَّا في السَّيْر، فلما وصلا ملتقى البحرين جلسا عند صخرة، ونسيا حوتهما الذي أُمر موسى بأخذه معه قوتًا لهما، وحمله يوشع في مِكْتَل، فإذا الحوت يصبح حيًّا وينحدر في البحر، ويتخذ له فيه طريقًا مفتوحًا."
   },
   "18:62": {
    "verses": {
     "18:62": {
      "id": 2202
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فلما فارقا المكان الذي نسيا فيه الحوت وشعر موسى بالجوع،<span class=\"blue\"> قال لخادمه:</span> أحضر إلينا غداءنا، لقد لقينا من سفرنا هذا تعبًا."
   },
   "18:63": {
    "verses": {
     "18:63": {
      "id": 2203
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال له خادمه:</span> أتذكر حين لجأنا إلى الصخرة التي استرحنا عندها؟ فإني نسيت أن أخبرك ما كان من الحوت، وما أنساني أن أذكر ذلك لك إلا الشيطان، فإن الحوت الميت دبَّتْ فيه الحياة، وقفز في البحر، واتخذ له فيه طريقًا، وكان أمره مما يُعْجَبُ منه."
   },
   "18:64": {
    "verses": {
     "18:64": {
      "id": 2204
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال موسى:</span> ما حصل هو ما كنا نطلبه، فإنه علامة لي على مكان العبد الصالح، فرجعا يقصان آثار مشيهما حتى انتهيا إلى الصخرة."
   }
  },
  "91": {
   "18:60": {
    "verses": {
     "18:60": {
      "id": 2200
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "يخبر تعالى عن نبيه موسى عليه السلام، وشدة رغبته في الخير وطلب العلم، أنه قال لفتاه -<span class=\"blue\"> أي:</span> خادمه الذي يلازمه في حضره وسفره، وهو \\<span class=\"red\">\" يوشع بن نون \\\"</span> الذي نبأه الله بعد ذلك:- <span class=\"arabic qpc-hafs brown\">{ لَا أَبْرَحُ حَتَّى أَبْلُغَ مَجْمَعَ الْبَحْرَيْنِ ْ}</span> أي: لا أزال مسافرا وإن طالت علي الشقة، ولحقتني المشقة، حتى أصل إلى مجمع البحرين، وهو المكان الذي أوحي إليه أنك ستجد فيه عبدا من عباد الله العالمين، عنده من العلم، ما ليس عندك، <span class=\"arabic qpc-hafs brown\">{ أَوْ أَمْضِيَ حُقُبًا ْ}</span> أي: مسافة طويلة،<span class=\"blue\"> المعنى:</span> أن الشوق والرغبة، حمل موسى أن قال لفتاه هذه المقالة، وهذا عزم منه جازم، فلذلك أمضاه."
   },
   "18:61": {
    "verses": {
     "18:61": {
      "id": 2201
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ فَلَمَّا بَلَغَا ْ}</span> أي: هو وفتاه <span class=\"arabic qpc-hafs brown\">{ مَجْمَعَ بَيْنِهِمَا نَسِيَا حُوتَهُمَا ْ}</span> وكان معهما حوت يتزودان منه ويأكلان، وقد وعد أنه متى فقد الحوت فثم ذلك العبد الذي قصدته، فاتخذ ذلك الحوت سبيله،<span class=\"blue\"> أي:</span> طريقه في البحر سربا وهذا من الآيات. قال المفسرون إن ذلك الحوت الذي كانا يتزودان منه، لما وصلا إلى ذلك المكان، أصابه بلل البحر، فانسرب بإذن الله في البحر، وصار مع حيواناته حيا."
   },
   "18:62": {
    "verses": {
     "18:62": {
      "id": 2202
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "فلما جاوز موسى وفتاه مجمع البحرين،<span class=\"blue\"> قال موسى لفتاه:</span> <span class=\"arabic qpc-hafs brown\">{ آتِنَا غَدَاءَنَا لَقَدْ لَقِينَا مِنْ سَفَرِنَا هَذَا نَصَبًا ْ}</span> أي: لقد تعبنا من هذا السفر المجاوز فقط، وإلا فالسفر الطويل الذي وصلا به إلى مجمع البحرين لم يجدا مس التعب فيه، وهذا من الآيات والعلامات الدالة لموسى، على وجود مطلبه، وأيضا فإن الشوق المتعلق بالوصول إلى ذلك المكان، سهل لهما الطريق، فلما تجاوزا غايتهما وجدا مس التعب"
   },
   "18:63": {
    "verses": {
     "18:63": {
      "id": 2203
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال له فتاه:</span> <span class=\"arabic qpc-hafs brown\">{ أَرَأَيْتَ إِذْ أَوَيْنَا إِلَى الصَّخْرَةِ فَإِنِّي نَسِيتُ الْحُوتَ ْ}</span>  أي: ألم تعلم حين آوانا الليل إلى تلك الصخرة المعروفة بينهما <span class=\"arabic qpc-hafs brown\">{ فإني نسيت الحوت وما أنسانيه إلا الشيطان ْ}</span> لأنه السبب في ذلك <span class=\"arabic qpc-hafs brown\">{ وَاتَّخَذَ سَبِيلَهُ فِي الْبَحْرِ عَجَبًا ْ}</span> أي: لما انسرب في البحر ودخل فيه، كان ذلك من العجائب.<span class=\"blue\">قال المفسرون:</span> كان ذلك المسلك للحوت سربا، ولموسى وفتاه عجبا، فلما قال له الفتى هذا القول، وكان عند موسى وعد من الله أنه إذا فقد الحوت، وجد الخضر،<span class=\"blue\"> فقال موسى:</span> <span class=\"arabic qpc-hafs brown\">{ ذَلِكَ مَا كُنَّا نَبْغِ ْ}</span>"
   },
   "18:64": {
    "verses": {
     "18:64": {
      "id": 2204
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "ـ <span class=\"arabic qpc-hafs brown\">{ ذَلِكَ مَا كُنَّا نَبْغِ ْ}</span> أي: نطلب <span class=\"arabic qpc-hafs brown\">{ فَارْتَدَّا ْ}</span> أي: رجعا <span class=\"arabic qpc-hafs brown\">{ عَلَى آثَارِهِمَا قَصَصًا ْ}</span> أي رجعا يقصان أثرهما إلى المكان الذي نسيا فيه الحوت"
   }
  }
 },
