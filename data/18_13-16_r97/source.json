   "translations": [
    {
     "id": 97063,
     "resource_id": 20,
     "text": "[The youths said to one another], \"And when you have withdrawn from them and that which they worship other than Allāh, retreat to the cave. Your Lord will spread out for you of His mercy and will prepare for you from your affair facility.\""
