   ],
   "translations": [
    {
     "id": 97052,
     "resource_id": 20,
     "text": "Those are the ones who disbelieve in the verses of their Lord and in [their] meeting Him, so their deeds have become worthless; and We will not assign to them on the Day of Resurrection any weight [i.e., importance]."
    }
   ]
  },
  {
