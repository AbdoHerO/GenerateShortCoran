 "tafsirs": {
  "16": {
   "18:77": {
    "verses": {
     "18:77": {
      "id": 2217
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فذهب موسى والخَضِر حتى أتيا أهل قرية، فطلبا منهم طعامًا على سبيل الضيافة، فامتنع أهل القرية عن ضيافتهما، فوجدا فيها حائطًا مائلا يوشك أن يسقط، فعدَّل الخَضِر مَيْلَه حتى صار مستويًا،<span class=\"blue\"> قال له موسى:</span> لو شئت لأخذت على هذا العمل أجرًا تصرفه في تحصيل طعامنا حيث لم يضيفونا."
   },
   "18:78": {
    "verses": {
     "18:78": {
      "id": 2218
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال الخَضِر لموسى:</span> هذا وقت الفراق بيني وبينك، سأخبرك بما أنكرت عليَّ من أفعالي التي فعلتها، والتي لم تستطع صبرًا على ترك السؤال عنها والإنكار عليَّ فيها."
   }
  },
  "91": {
   "18:77": {
    "verses": {
     "18:77": {
      "id": 2217
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ فَانْطَلَقَا حَتَّى إِذَا أَتَيَا أَهْلَ قَرْيَةٍ اسْتَطْعَمَا أَهْلَهَا ْ}</span> أي: استضافاهم، فلم يضيفوهما <span class=\"arabic qpc-hafs brown\">{ فَوَجَدَا فِيهَا جِدَارًا يُرِيدُ أَنْ يَنْقَضَّ ْ}</span> أي: قد عاب واستهدم <span class=\"arabic qpc-hafs brown\">{ فَأَقَامَهُ ْ}</span> الخضر أي: بناه وأعاده جديدا.<span class=\"blue\"> فقال له موسى:</span> <span class=\"arabic qpc-hafs brown\">{ لَوْ شِئْتَ لَاتَّخَذْتَ عَلَيْهِ أَجْرًا ْ}</span> أي: أهل هذه القرية، لم يضيفونا مع وجوب ذلك عليهم، وأنت تبنيه من دون أجرة، وأنت تقدر عليها؟. فحينئذ لم يف موسى عليه السلام بما قال، واستعذر الخضر منه"
   },
   "18:78": {
    "verses": {
     "18:78": {
      "id": 2218
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ هَذَا فِرَاقُ بَيْنِي وَبَيْنِكَ ْ}</span> فإنك شرطت ذلك على نفسك، فلم يبق الآن عذر، ولا موضع للصحبة، <span class=\"arabic qpc-hafs brown\">{ سَأُنَبِّئُكَ بِتَأْوِيلِ مَا لَمْ تَسْتَطِعْ عَلَيْهِ صَبْرًا ْ}</span> أي: سأخبرك بما أنكرت عليَّ، وأنبئك بما لي في ذلك من المآرب، وما يئول إليه الأمر."
   }
  }
 },
