   "translations": [
    {
     "id": 97108,
     "resource_id": 20,
     "text": "And nothing has prevented the people from believing when guidance came to them and from asking forgiveness of their Lord except that there [must] befall them the [accustomed] precedent of the former peoples<sup foot_note=196706>1</sup> or that the punishment should come [directly] before them."
    }
   ]
  },
