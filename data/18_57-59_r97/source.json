   "translations": [
    {
     "id": 97111,
     "resource_id": 20,
     "text": "And your Lord is the Forgiving, the possessor of mercy. If He were to impose blame upon them for what they earned, He would have hastened for them the punishment. Rather, for them is an appointment from which they will never find an escape."
    }
