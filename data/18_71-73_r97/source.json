 "tafsirs": {
  "16": {
   "18:71": {
    "verses": {
     "18:71": {
      "id": 2211
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فانطلقا يمشيان على الساحل، فمرت بهما سفينة، فطلبا من أهلها أن يركبا معهم، فلما ركبا قَلَعَ الخَضِر لوحًا من السفينة فخرقها،<span class=\"blue\"> فقال له موسى:</span> أَخَرَقْتَ السفينة؛ لتُغرِق أهلَها، وقد حملونا بغير أجر؟ لقد فعلت أمرًا منكرًا."
   },
   "18:72": {
    "verses": {
     "18:72": {
      "id": 2212
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال له الخَضِر:</span> لقد قلت لك من أول الأمر: إنك لن تستطيع الصبر على صحبتي."
   },
   "18:73": {
    "verses": {
     "18:73": {
      "id": 2213
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال موسى معتذرًا:</span> لا تؤاخذني بنسياني شرطك عليَّ، ولا تكلفني مشقةً في تعلُّمي منك، وعاملني بيسر ورفق."
   }
  },
  "91": {
   "18:71": {
    "verses": {
     "18:71": {
      "id": 2211
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ فَانْطَلَقَا حَتَّى إِذَا رَكِبَا فِي السَّفِينَةِ خَرَقَهَا ْ}</span> أي: اقتلع الخضر منها لوحا، وكان له مقصود في ذلك، سيبينه، فلم يصبر موسى عليه السلام، لأن ظاهره أنه منكر، لأنه عيب للسفينة، وسبب لغرق أهلها،<span class=\"blue\"> ولهذا قال موسى:</span> <span class=\"arabic qpc-hafs brown\">{ أَخَرَقْتَهَا لِتُغْرِقَ أَهْلَهَا لَقَدْ جِئْتَ شَيْئًا إِمْرًا ْ}</span> أي: عظيما شنيعا، وهذا من عدم صبره عليه السلام"
   },
   "18:72": {
    "verses": {
     "18:72": {
      "id": 2212
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ أَلَمْ أَقُلْ إِنَّكَ لَنْ تَسْتَطِيعَ مَعِيَ صَبْرًا ْ}</span> أي: فوقع كما أخبرتك، وكان هذا من موسى نسيانا"
   },
   "18:73": {
    "verses": {
     "18:73": {
      "id": 2213
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ لَا تُؤَاخِذْنِي بِمَا نَسِيتُ وَلَا تُرْهِقْنِي مِنْ أَمْرِي عُسْرًا ْ}</span> أي: لا تعسر علي الأمر، واسمح لي، فإن ذلك وقع على وجه النسيان، فلا تؤاخذني في أول مرة. فجمع بين الإقرار به والعذر منه، وأنه ما ينبغي لك أيها الخضر الشدة على صاحبك، فسمح عنه الخضر."
   }
  }
 },
