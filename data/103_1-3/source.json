 "tafsirs": {
  "16": {
   "103:1": {
    "verses": {
     "103:1": {
      "id": 6177
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "أقسم الله بالدهر؛ لما فيه من عجائب قدرة الله الدالة على عظمته، على أن بني آدم لفي هلكة ونقصان. ولا يجوز للعبد أن يقسم إلا بالله، فإن القسم بغير الله شرك."
   },
   "103:2": {
    "verses": {
     "103:2": {
      "id": 6178
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "أقسم الله بالدهر على أن بني آدم لفي هلكة ونقصان. ولا يجوز للعبد أن يقسم إلا بالله، فإن القسم بغير الله شرك."
   },
   "103:3": {
    "verses": {
     "103:3": {
      "id": 6179
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "إلا الذين آمنوا بالله وعملوا عملا صالحًا، وأوصى بعضهم بعضًا بالاستمساك بالحق، والعمل بطاعة الله، والصبر على ذلك."
   }
  },
  "91": {
   "103:1": {
    "verses": {
     "103:1": {
      "id": 6177
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "أقسم تعالى بالعصر، الذي هو الليل والنهار، محل أفعال العباد وأعمالهم"
   },
   "103:2": {
    "verses": {
     "103:2": {
      "id": 6178
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "أن كل إنسان خاسر، والخاسر ضد الرابح.<span class=\"blue\">والخسار مراتب متعددة متفاوتة:</span>قد يكون خسارًا مطلقًا، كحال من خسر الدنيا والآخرة، وفاته النعيم، واستحق الجحيم."
   },
   "103:3": {
    "verses": {
     "103:3": {
      "id": 6179
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "وقد يكون خاسرًا من بعض الوجوه دون بعض، ولهذا عمم الله الخسار لكل إنسان،<span class=\"blue\"> إلا من اتصف بأربع صفات:</span>الإيمان بما أمر الله بالإيمان به، ولا يكون الإيمان بدون العلم، فهو فرع عنه لا يتم إلا به.والعمل الصالح، وهذا شامل لأفعال الخير كلها، الظاهرة والباطنة، المتعلقة بحق الله وحق عباده  ، الواجبة والمستحبة.والتواصي بالحق، الذي هو الإيمان والعمل الصالح،<span class=\"blue\"> أي:</span> يوصي بعضهم بعضًا بذلك، ويحثه عليه، ويرغبه فيه.والتواصي بالصبر على طاعة الله، وعن معصية الله، وعلى أقدار الله المؤلمة.فبالأمرين الأولين، يكمل الإنسان  نفسه، وبالأمرين الأخيرين يكمل غيره، وبتكميل الأمور الأربعة، يكون الإنسان قد سلم من الخسار، وفاز بالربح <span class=\"arabic qpc-hafs\">[العظيم]</span>."
   }
  }
 },
