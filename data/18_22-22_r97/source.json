   "translations": [
    {
     "id": 97070,
     "resource_id": 20,
     "text": "They [i.e., people] will say there were three, the fourth of them being their dog; and they will say there were five, the sixth of them being their dog - guessing at the unseen; and they will say there were seven, and the eighth of them was their dog. Say, [O Muḥammad], \"My Lord is most knowing of their number. None knows them except a few. So do not argue about them except with an obvious argument<sup foot_note=196697>1</sup> and do not inquire about them among [the speculators] from anyone.\""
    }
   ]
  }
