 "tafsirs": {
  "16": {
   "18:79": {
    "verses": {
     "18:79": {
      "id": 2219
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "أما السفينة التي خرقتها فإنها كانت لأناس محتاجين -لا يملكون ما يكفيهم ويسد حاجتهم- يعملون في البحر عليها سعيًا وراء الرزق، فأردت أن أعيبها بذلك الخرق؛ لأن أمامهم ملكًا يأخذ كل سفينة صالحة غصبًا من أصحابها."
   },
   "18:80": {
    "verses": {
     "18:80": {
      "id": 2220
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "وأما الغلام الذي قتلته فكان في علم الله كافرًا، وكان أبوه وأمه مؤمِنَيْن، فخشينا لو بقي الغلام حيًا لَحمل والديه على الكفر والطغيان؛ لأجل محبتهما إياه أو للحاجة إليه."
   },
   "18:81": {
    "verses": {
     "18:81": {
      "id": 2221
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فأردنا أن يُبْدِل الله أبويه بمن هو خير منه صلاحًا ودينًا وبرًا بهما."
   }
  },
  "91": {
   "18:79": {
    "verses": {
     "18:79": {
      "id": 2219
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ أَمَّا السَّفِينَةُ ْ}</span> التي خرقتها <span class=\"arabic qpc-hafs brown\">{ فَكَانَتْ لِمَسَاكِينَ يَعْمَلُونَ فِي الْبَحْرِ ْ}</span> يقتضي ذلك الرقة عليهم، والرأفة بهم. <span class=\"arabic qpc-hafs brown\">{ فَأَرَدْتُ أَنْ أَعِيبَهَا وَكَانَ وَرَاءَهُمْ مَلِكٌ يَأْخُذُ كُلَّ سَفِينَةٍ غَصْبًا ْ}</span> أي: كان مرورهم على ذلك الملك الظالم، فكل سفينة صالحة تمر عليه ما فيها عيب غصبها وأخذها ظلما، فأردت أن أخرقها ليكون فيها عيب، فتسلم من ذلك الظالم."
   },
   "18:80": {
    "verses": {
     "18:80": {
      "id": 2220
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ وَأَمَّا الْغُلَامُ ْ}</span> الذي قتلته <span class=\"arabic qpc-hafs brown\">{ فَكَانَ أَبَوَاهُ مُؤْمِنَيْنِ فَخَشِينَا أَنْ يُرْهِقَهُمَا طُغْيَانًا وَكُفْرًا ْ}</span> وكان ذلك الغلام قد قدر عليه أنه لو بلغ لأرهق أبويه طغيانا وكفرا،<span class=\"blue\"> أي:</span> لحملهما على الطغيان والكفر، إما لأجل محبتهما إياه، أو للحاجة إليه أو يحدهما على ذلك،<span class=\"blue\"> أي:</span> فقتلته، لاطلاعي على ذلك، سلامة لدين أبويه المؤمنين، وأي فائدة أعظم من هذه الفائدة الجليلة؟\\\" وهو وإن كان فيه إساءة إليهما، وقطع لذريتهما، فإن الله تعالى سيعطيهما من الذرية، ما هو خير منه"
   },
   "18:81": {
    "verses": {
     "18:81": {
      "id": 2221
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ فَأَرَدْنَا أَنْ يُبْدِلَهُمَا رَبُّهُمَا خَيْرًا مِنْهُ زَكَاةً وَأَقْرَبَ رُحْمًا ْ}</span> أي: ولدا صالحا، زكيا، واصلا لرحمه، فإن الغلام الذي قتل لو بلغ لعقهما أشد العقوق بحملهما على الكفر والطغيان."
   }
  }
 },
