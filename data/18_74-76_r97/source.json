    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فقبل الخَضِر عذره، ثم خرجا من السفينة، فبينما هما يمشيان على الساحل إذ أبصرا غلامًا يلعب مع الغلمان، فقتله الخَضِر،<span class=\"blue\"> فأنكر موسى عليه وقال:</span> كيف قتلت نفسًا طاهرة لم تبلغ حدَّ التكليف، ولم تقتل نفسًا، حتى تستحق القتل بها؟ لقد فَعَلْتَ أمرًا منكرًا عظيمًا."
   },
   "18:75": {
    "verses": {
     "18:75": {
      "id": 2215
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال الخَضِر لموسى معاتبًا ومذكرًا:</span> ألم أقل لك إنك لن تستطيع معي صبرًا على ما ترى من أفعالي مما لم تحط به خُبْرًا؟"
   },
   "18:76": {
    "verses": {
     "18:76": {
      "id": 2216
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال موسى له:</span> إن سألتك عن شيء بعد هذه المرة فاتركني ولا تصاحبني، قد بلغتَ العذر في شأني ولم تقصر؛ حيث أخبرتَني أني لن أستطيع معك صبرًا."
   }
  },
  "91": {
   "18:74": {
    "verses": {
     "18:74": {
      "id": 2214
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"arabic qpc-hafs brown\">{ فَانْطَلَقَا حَتَّى إِذَا لَقِيَا غُلَامًا ْ}</span> أي: صغيرا <span class=\"arabic qpc-hafs brown\">{ فَقَتَلَهُ ْ}</span> الخضر، فاشتد بموسى الغضب، وأخذته الحمية الدينية، حين قتل غلاما صغيرا لم يذنب. <span class=\"arabic qpc-hafs brown\">{ قَالَ أَقَتَلْتَ نَفْسًا زَكِيَّةً بِغَيْرِ نَفْسٍ لَقَدْ جِئْتَ شَيْئًا نُكْرًا ْ}</span> وأي: نكر مثل قتل الصغير، الذي ليس عليه ذنب، ولم يقتل أحد؟! وكانت الأولى من موسى نسيانا، وهذه غير نسيان، ولكن عدم صبر"
   },
   "18:75": {
    "verses": {
     "18:75": {
      "id": 2215
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">فقال له الخضر معاتبا ومذكرا:</span> <span class=\"arabic qpc-hafs brown\">{ أَلَمْ أَقُلْ لَكَ إِنَّكَ لَنْ تَسْتَطِيعَ مَعِيَ صَبْرًا ْ}</span>"
   },
   "18:76": {
    "verses": {
     "18:76": {
      "id": 2216
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "فقال <span class=\"arabic qpc-hafs\">[له]</span> موسى: <span class=\"arabic qpc-hafs brown\">{ إِنْ سَأَلْتُكَ عَنْ شَيْءٍ ْ}</span> بعد هذه المرة <span class=\"arabic qpc-hafs brown\">{ فَلَا تُصَاحِبْنِي ْ}</span> أي: فأنت معذور بذلك، وبترك صحبتي <span class=\"arabic qpc-hafs brown\">{ قَدْ بَلَغْتَ مِنْ لَدُنِّي عُذْرًا ْ}</span> أي: أعذرت مني، ولم تقصر."
   }
  }
 },
