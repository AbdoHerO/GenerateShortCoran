   ],
   "translations": [
    {
     "id": 98279,
     "resource_id": 20,
     "text": "And indeed, your Lord - He is the Exalted in Might, the Merciful."
    }
   ]
  }
 ],
 "tafsirs": {
  "16": {
   "26:60": {
    "verses": {
     "26:60": {
      "id": 2992
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فلحق فرعون وجنده موسى ومَن معه وقت شروق الشمس."
   },
   "26:61": {
    "verses": {
     "26:61": {
      "id": 2993
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">فلما رأى كل واحد من الفريقين الآخر قال أصحاب موسى:</span> إنَّ جَمْعَ فرعون مُدْرِكنا ومهلكنا."
   },
   "26:62": {
    "verses": {
     "26:62": {
      "id": 2994
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">قال موسى لهم:</span> كلا ليس الأمر كما ذكرتم فلن تُدْرَكوا; إن معي ربي بالنصر، سيهديني لما فيه نجاتي ونجاتكم."
   },
   "26:63": {
    "verses": {
     "26:63": {
      "id": 2995
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "فأوحينا إلى موسى أن اضرب بعصاك البحر، فضرب، فانفلق البحر إلى اثني عشر طريقًا بعدد قبائل بني إسرائيل، فكانت كل قطعة انفصلت من البحر كالجبل العظيم."
   },
   "26:64": {
    "verses": {
     "26:64": {
      "id": 2996
     },
     "26:65": {
      "id": 2997
     },
     "26:66": {
      "id": 2998
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "وقرَّبْنا هناك فرعون وقومه حتى دخلوا البحر، وأنجينا موسى ومَن معه أجمعين. فاستمر البحر على انفلاقه حتى عبروا إلى البر، ثم أغرقنا فرعون ومن معه بإطباق البحر عليهم بعد أن دخلوا فيه متبعين موسى وقومه."
   },
   "26:65": {
    "verses": {
     "26:64": {
      "id": 2996
     },
     "26:65": {
      "id": 2997
     },
     "26:66": {
      "id": 2998
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "وقرَّبْنا هناك فرعون وقومه حتى دخلوا البحر، وأنجينا موسى ومَن معه أجمعين. فاستمر البحر على انفلاقه حتى عبروا إلى البر، ثم أغرقنا فرعون ومن معه بإطباق البحر عليهم بعد أن دخلوا فيه متبعين موسى وقومه."
   },
   "26:66": {
    "verses": {
     "26:64": {
      "id": 2996
     },
     "26:65": {
      "id": 2997
     },
     "26:66": {
      "id": 2998
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "وقرَّبْنا هناك فرعون وقومه حتى دخلوا البحر، وأنجينا موسى ومَن معه أجمعين. فاستمر البحر على انفلاقه حتى عبروا إلى البر، ثم أغرقنا فرعون ومن معه بإطباق البحر عليهم بعد أن دخلوا فيه متبعين موسى وقومه."
   },
   "26:67": {
    "verses": {
     "26:67": {
      "id": 2999
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "إن في ذلك الذي حدث لَعبرة عجيبة دالة على قدرة الله، وما صار أكثر أتباع فرعون مؤمنين مع هذه العلامة الباهرة."
   },
   "26:68": {
    "verses": {
     "26:68": {
      "id": 3000
     }
    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "وإن ربك لهو العزيز الرحيم، بعزته أهلك الكافرين المكذبين، وبرحمته نجَّى موسى ومَن معه أجمعين."
   }
  },
  "91": {
   "26:60": {
    "verses": {
     "26:60": {
      "id": 2992
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"blue\">فَأَتْبَعُوهُمْ مُشْرِقِينَ  أي:</span> اتبع قوم فرعون قوم موسى, وقت شروق الشمس, وساقوا خلفهم محثين, على غيظ وحنق قادرين."
   },
   "26:61": {
    "verses": {
     "26:61": {
      "id": 2993
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "فَلَمَّا تَرَاءَى الْجَمْعَانِ  أي رأى كل منهما صاحبه،  قَالَ أَصْحَابُ مُوسَى  شاكين لموسى وحزنين  إِنَّا لَمُدْرَكُونَ"
   },
   "26:62": {
    "verses": {
     "26:62": {
      "id": 2994
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "قَالَ  موسى, مثبتا لهم,<span class=\"blue\"> ومخبرا لهم بوعد ربه الصادق:</span>  كُلا  أي: ليس الأمر كما ذكرتم, أنكم مدركون،  إِنَّ مَعِيَ رَبِّي سَيَهْدِينِ  لما فيه نجاتي ونجاتكم."
   },
   "26:63": {
    "verses": {
     "26:63": {
      "id": 2995
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "<span class=\"ar blue\" lang=\"ar\">فَأَوْحَيْنَا إِلَى مُوسَى أَنِ اضْرِبْ بِعَصَاكَ الْبَحْرَ  فضربه  فَانْفَلَقَ  اثني عشر طريقا  فَكَانَ كُلُّ فِرْقٍ كَالطَّوْدِ  أي:</span> الجبل  الْعَظِيمِ  فدخله موسى وقومه."
   },
   "26:64": {
    "verses": {
     "26:64": {
      "id": 2996
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "وَأَزْلَفْنَا ثَمَّ  في ذلك المكان  الآخَرِينَ  أي فرعون وقومه, قربناهم, وأدخلناهم في ذلك الطريق, الذي سلك منه موسى وقومه."
   },
   "26:65": {
    "verses": {
     "26:65": {
      "id": 2997
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "وَأَنْجَيْنَا مُوسَى وَمَنْ مَعَهُ أَجْمَعِينَ  استكملوا خارجين, لم يتخلف منهم أحد."
   },
   "26:66": {
    "verses": {
     "26:66": {
      "id": 2998
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "ثُمَّ أَغْرَقْنَا الآخَرِينَ  لم يتخلف منهم عن الغرق أحد."
   },
   "26:67": {
    "verses": {
     "26:67": {
      "id": 2999
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "إِنَّ فِي ذَلِكَ لآيَةً  عظيمة, على صدق ما جاء به موسى عليه السلام, وبطلان ما عليه فرعون وقومه،  وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ  مع هذه الآيات المقتضية للإيمان, لفساد قلوبكم."
   },
   "26:68": {
    "verses": {
     "26:68": {
      "id": 3000
     }
    },
    "resource_id": 91,
    "resource_name": "Arabic Saddi Tafseer",
    "language_id": 9,
    "slug": "ar-tafseer-al-saddi",
    "translated_name": {
     "name": "السعدي Al-Sa'di",
     "language_name": "english"
    },
    "text": "وَإِنَّ رَبَّكَ لَهُوَ الْعَزِيزُ الرَّحِيمُ  بعزته أهلك الكافرين المكذبين، وبرحمته نجى موسى, ومن معه أجمعين."
   }
  }
 },
