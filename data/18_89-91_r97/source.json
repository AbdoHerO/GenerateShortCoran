    },
    "resource_id": 16,
    "resource_name": "المیسر",
    "language_id": 9,
    "slug": "ar-tafsir-muyassar",
    "translated_name": {
     "name": "Tafsir Muyassar",
     "language_name": "english"
    },
    "text": "كذلك وقد أحاط عِلْمُنا بما عنده من الخير والأسباب العظيمة، حيثما توجَّه وسار."
   }
  },
